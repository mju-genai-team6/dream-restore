# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 않습니다.
# 새 키가 필요하면 여기에 "키 이름만" 추가합니다.
# 프론트엔드 주소(NEXT_PUBLIC_API_BASE_URL)는 이 파일이 아니라 frontend/.env.local에 넣습니다 (README 참고).

# ── 꼭 채울 값 ─────────────────────────────────────────────
# 장면 분할·STT(D), 이미지(E2), TTS(E2)가 모두 이 키를 쓴다
OPENAI_API_KEY=

# ── 서버·DB (로컬 기본값 그대로 쓰면 됨) ─────────────────────
APP_ENV=local
DATABASE_URL=postgresql+psycopg://dream:dream@localhost:5432/dream
# pytest 전용 DB (C2). 개발 DB와 분리되어 테스트가 개발 데이터를 건드리지 않습니다.
TEST_DATABASE_URL=postgresql+psycopg://dream:dream@localhost:5432/dream_test
STORAGE_ROOT=../storage
CORS_ORIGINS=http://localhost:3000

# 팀 고정값이라 바꾸지 않습니다
IMAGE_MAX_CONCURRENCY=3
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
LLM_TIMEOUT_SECONDS=30
JOB_TIMEOUT_SECONDS=300
AUDIO_MAX_MB=25

# ── 기능 스위치 (비워 두지 말고 값을 적을 것. 빈 값이면 서버가 켜지지 않음) ──
# fake: 이미지 API를 부르지 않고 단색 PNG 저장, real: 실제 이미지 API 호출(비용 발생)
IMAGE_GENERATION_MODE=real
# 나레이션 작업을 만들지. false면 나레이션 없이 영상, true면 장면마다 나레이션 추가
NARRATION_ENABLED=true
# true면 TTS를 부르지 않고 무음 mp3를 만든다 (비용 없이 흐름 확인용)
TTS_FAKE=false
# 이미지 프롬프트에 확신도 스타일 문구를 붙일지. 기본 false (이미지는 선명, 확신도는 렌더 블러로만)
CONFIDENCE_PROMPT_STYLE=false

# 프론트엔드
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── 선택: 바꿀 때만 주석을 풀기 (아래 값이 기본값) ──────────────
# TTS_API_KEY=                 # 비워 두면 TTS도 OPENAI_API_KEY를 쓴다. 다른 키를 쓸 때만 채운다
