# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 않습니다.
# 새 키가 필요하면 여기에 "키 이름만" 추가합니다.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://dream:dream@localhost:5432/dream
STORAGE_ROOT=../storage
CORS_ORIGINS=http://localhost:3000

# 외부 AI
OPENAI_API_KEY=
IMAGE_API_KEY=
TTS_API_KEY=

# 작업 처리
IMAGE_MAX_CONCURRENCY=3
JOB_TIMEOUT_SECONDS=300
AUDIO_MAX_MB=25

# 프론트엔드
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
